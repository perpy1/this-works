PORT=3001
NODE_ENV=development

# ============================================
# DATA SOURCE CONFIGURATION
# ============================================
# Choose your primary data platform: 'twitter', 'reddit', or 'multi'
# - twitter: Uses Twitter API v2 (requires paid API access)
# - reddit: Uses Reddit's free API (NO API KEY NEEDED!)
# - multi: Combines both platforms for broader coverage
DATA_PLATFORM=reddit

# ============================================
# TWITTER API v2 (Optional - only if using Twitter)
# ============================================
# Get from: https://developer.twitter.com/en/portal/dashboard
# Cost: Free tier very limited, Paid starts at $100/month
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ============================================
# ALTERNATIVE PAID SERVICES (Optional)
# ============================================

# Apify (Twitter scraping without API)
# Get from: https://apify.com/
# Cost: $5/month free credit, ~$0.25-$1 per 1000 tweets
APIFY_API_TOKEN=your_apify_token_here

# RapidAPI (Multiple Twitter scrapers available)
# Get from: https://rapidapi.com/
# Cost: Free tier 100-500 requests/month
RAPIDAPI_KEY=your_rapidapi_key_here

# ScraperAPI (Build custom scrapers with proxy rotation)
# Get from: https://www.scraperapi.com/
# Cost: 5000 free API credits
SCRAPER_API_KEY=your_scraper_api_key_here

# Google Custom Search API (Search Twitter via Google)
# Get from: https://developers.google.com/custom-search
# Cost: 100 searches/day free, then $5/1000 queries
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# ============================================
# PostgreSQL Database
# ============================================
DATABASE_URL=postgresql://username:password@localhost:5432/twitter_breakout
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twitter_breakout
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ============================================
# API Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# RECOMMENDED FREE SETUP (No API keys needed!)
# ============================================
# 1. Set DATA_PLATFORM=reddit
# 2. Reddit API is free and doesn't require authentication
# 3. You can analyze topics immediately!
#
# For best results with free tier:
# - Use DATA_PLATFORM=reddit for tech/startup topics
# - Reddit has generous rate limits (60 req/min)
# - No API key registration needed
# - Get similar insights to Twitter
